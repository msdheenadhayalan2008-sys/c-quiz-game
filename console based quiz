#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <time.h>

struct Question {
    char q[120];
    char opt[4][40];
    char ans; /* 'A' to 'D' */
};

struct Question cprog[5] = {
    {"Who developed the C language?", {"James Gosling", "Dennis Ritchie", "Bjarne Stroustrup", "Guido van Rossum"}, 'B'},
    {"Which symbol ends a C statement?", {".", ":", ";", ","}, 'C'},
    {"Which header file is needed for printf()?", {"stdlib.h", "stdio.h", "string.h", "math.h"}, 'B'},
    {"Size of int in most systems (bytes)?", {"1", "2", "4", "8"}, 'C'},
    {"Which loop runs at least once?", {"for", "while", "do-while", "none"}, 'C'}
};

struct Question gk[5] = {
    {"Capital of Tamil Nadu?", {"Madurai", "Chennai", "Coimbatore", "Salem"}, 'B'},
    {"National animal of India?", {"Lion", "Elephant", "Tiger", "Leopard"}, 'C'},
    {"Father of the Nation?", {"Nehru", "Gandhi", "Bose", "Patel"}, 'B'},
    {"How many states are in India?", {"28", "29", "30", "27"}, 'A'},
    {"Longest river in India?", {"Yamuna", "Godavari", "Ganga", "Kaveri"}, 'C'}
};

struct Question tech[10] = {
    {"Full form of CPU?", {"Central Process Unit", "Central Processing Unit", "Control Processing Unit", "Central Program Unit"}, 'B'},
    {"Which one is an operating system?", {"Oracle", "Linux", "Python", "HTML"}, 'B'},
    {"HTML stands for?", {"Hyper Text Markup Language", "High Text Machine Language", "Hyper Tool Markup Language", "Home Text Markup Language"}, 'A'},
    {"Which one is NOT a programming language?", {"Python", "Java", "HTML", "C++"}, 'C'},
    {"1 byte = ? bits", {"4", "8", "16", "32"}, 'B'},
    {"Which one is an input device?", {"Monitor", "Printer", "Keyboard", "Speaker"}, 'C'},
